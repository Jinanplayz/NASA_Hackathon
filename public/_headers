# Cloudflare Pages response headers (this file is read by Cloudflare, not served to players).

# Code, fonts and styles have a fingerprint in their file name, so browsers can keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Captain Nova's recordings are named after their text, so a changed line gets a new file.
/content/:chapter/audio/voice/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
